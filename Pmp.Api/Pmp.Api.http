@Pmp.Api_HostAddress = http://localhost:5218

### Get the first page of projects (the response includes hasNextPage)
GET {{Pmp.Api_HostAddress}}/api/projects?page=1&status=PendingApproval
Accept: application/json

###

### Get a project by ID
GET {{Pmp.Api_HostAddress}}/api/projects/{projectId}
Accept: application/json

###

### Create a project
POST {{Pmp.Api_HostAddress}}/api/projects
Content-Type: application/json

{
  "customerName": "Example Customer",
  "projectName": "Example Project",
  "projectStartDate": "2026-01-01T00:00:00Z",
  "projectEndDate": "2026-06-30T00:00:00Z",
  "revisedEndDate": null,
  "renewalDate": null,
  "projectIssueDate": "2025-12-15T00:00:00Z",
  "estimatedHours": 1200,
  "actualHours": null,
  "onshoreManagerName": "Onshore Manager",
  "offshoreManagerName": "Offshore Manager",
  "accountManagerName": "Account Manager",
  "wizardDetails": {
    "customerAddress": "1 Example Street",
    "projectSector": "Business",
    "clientContactName": "Client Contact",
    "clientEmail": "client@example.com",
    "clientPmName": "Client PM",
    "clientPmEmail": "pm@example.com",
    "projectDescription": "Example project description",
    "scope": "Example project scope",
    "managedBy": "Internal PMO",
    "domain": "Operations",
    "type": "Fixed Price",
    "totalValue": 100000,
    "methodology": "Agile",
    "technology": "Angular",
    "lead": "Project Lead",
    "stakeholders": "Business stakeholders"
  },
  "tasks": [
    { "name": "Discovery", "description": "Discover requirements" }
  ],
  "efforts": [
    { "person": "Project Lead", "taskName": "Discovery", "estimatedHours": 40 }
  ]
}

###

### Update a project
PUT {{Pmp.Api_HostAddress}}/api/projects/{projectId}
Content-Type: application/json

{
  "customerName": "Example Customer",
  "projectName": "Updated Project",
  "projectStartDate": "2026-01-01T00:00:00Z",
  "projectEndDate": "2026-07-31T00:00:00Z",
  "revisedEndDate": "2026-07-15T00:00:00Z",
  "renewalDate": null,
  "projectIssueDate": "2025-12-15T00:00:00Z",
  "estimatedHours": 1400,
  "actualHours": 300,
  "onshoreManagerName": "Onshore Manager",
  "offshoreManagerName": "Offshore Manager",
  "accountManagerName": "Account Manager",
  "wizardDetails": {
    "customerAddress": "1 Example Street",
    "projectSector": "Business",
    "clientContactName": "Client Contact",
    "clientEmail": "client@example.com",
    "clientPmName": "Client PM",
    "clientPmEmail": "pm@example.com",
    "projectDescription": "Updated description",
    "scope": "Updated scope",
    "managedBy": "Internal PMO",
    "domain": "Operations",
    "type": "Fixed Price",
    "totalValue": 100000,
    "methodology": "Agile",
    "technology": "Angular",
    "lead": "Project Lead",
    "stakeholders": "Business stakeholders"
  },
  "tasks": [],
  "efforts": []
}

###

### Update project status
PATCH {{Pmp.Api_HostAddress}}/api/projects/{projectId}
Content-Type: application/json

{
  "status": "Completed"
}
